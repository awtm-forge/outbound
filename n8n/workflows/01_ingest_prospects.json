{
 "name": "01_ingest_prospects",
 "nodes": [
  {
   "position": [
    220,
    300
   ],
   "name": "Webhook",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "parameters": {
    "httpMethod": "POST",
    "path": "awtm/ingest",
    "responseMode": "responseNode",
    "options": {}
   },
   "webhookId": "01_ingest_prospects"
  },
  {
   "name": "Log error",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    400,
    600
   ],
   "parameters": {
    "method": "POST",
    "url": "={{ $env.CORE_URL }}/api/workflow-runs/log-error",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "X-Api-Key",
       "value": "={{ $env.CORE_API_KEY }}"
      },
      {
       "name": "Idempotency-Key",
       "value": "={{ $execution.id }}-log-error-{{ $itemIndex }}"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ { workflow: \"01_ingest_prospects\", execution_id: $execution.id, error: JSON.stringify($json.error || $json), detail: { node: $prevNode.name } } }}",
    "options": {
     "timeout": 20000
    }
   }
  },
  {
   "position": [
    440,
    300
   ],
   "name": "Guard",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2,
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "g1",
       "leftValue": "={{ $json.headers[\"x-api-key\"] }}",
       "rightValue": "={{ $env.CORE_API_KEY }}",
       "operator": {
        "type": "string",
        "operation": "equals"
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   }
  },
  {
   "name": "Respond 401",
   "type": "n8n-nodes-base.respondToWebhook",
   "typeVersion": 1.1,
   "position": [
    440,
    500
   ],
   "parameters": {
    "respondWith": "json",
    "responseBody": "={{ { error: \"unauthorized\" } }}",
    "options": {
     "responseCode": 401
    }
   }
  },
  {
   "position": [
    660,
    300
   ],
   "name": "Bulk ingest",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "onError": "continueErrorOutput",
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 3000,
   "parameters": {
    "method": "POST",
    "url": "={{ $env.CORE_URL }}/api/prospects/bulk",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "X-Api-Key",
       "value": "={{ $env.CORE_API_KEY }}"
      },
      {
       "name": "Idempotency-Key",
       "value": "={{ $execution.id }}-bulk-ingest-{{ $itemIndex }}"
      },
      {
       "name": "X-Actor",
       "value": "n8n"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ { prospects: $json.body.prospects } }}",
    "options": {
     "timeout": 180000
    }
   }
  },
  {
   "position": [
    880,
    300
   ],
   "name": "Split results",
   "type": "n8n-nodes-base.splitOut",
   "typeVersion": 1,
   "parameters": {
    "fieldToSplitOut": "results",
    "options": {}
   }
  },
  {
   "position": [
    1100,
    300
   ],
   "name": "If Run chain",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2,
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "c1",
       "leftValue": "={{ $json.ok && $json.created }}",
       "rightValue": "true",
       "operator": {
        "type": "string",
        "operation": "equals"
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   }
  },
  {
   "position": [
    1320,
    300
   ],
   "name": "Run chain",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "onError": "continueErrorOutput",
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 3000,
   "parameters": {
    "method": "POST",
    "url": "={{ $env.CORE_URL }}/api/prospects/{{ $json.prospect_id }}/run-chain",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "X-Api-Key",
       "value": "={{ $env.CORE_API_KEY }}"
      },
      {
       "name": "Idempotency-Key",
       "value": "={{ $execution.id }}-run-chain-{{ $itemIndex }}"
      },
      {
       "name": "X-Actor",
       "value": "n8n"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ { workflow_run_id: null } }}",
    "options": {
     "timeout": 180000
    }
   }
  },
  {
   "position": [
    1540,
    300
   ],
   "name": "Respond",
   "type": "n8n-nodes-base.respondToWebhook",
   "typeVersion": 1.1,
   "parameters": {
    "respondWith": "allIncomingItems",
    "options": {}
   }
  }
 ],
