     }
    ]
   ]
  },
  "Bulk ingest": {
   "main": [
    [
     {
      "node": "Split results",
      "type": "main",
      "index": 0
     }
    ],
    [
     {
      "node": "Log error",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Split results": {
   "main": [
    [
     {
      "node": "If Run chain",
      "type": "main",
      "index": 0
     }
    ]
   ]
