# Copy to .env and fill in. Never commit .env.

# ---- Database ----
# Hostinger Cloud + Neon: the pooled connection string from Neon (host contains -pooler), with ?sslmode=require.
# Docker Compose ignores this and builds its own from the POSTGRES_* values below.
DATABASE_URL=

# ---- Postgres (private to the docker network; host port only for local dev) ----
POSTGRES_DB=awtm_outbound
POSTGRES_USER=awtm
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-32
POSTGRES_HOST_PORT=55460

# ---- Core service ----
CORE_PORT=8080
# API key n8n uses to call the core (X-Api-Key). openssl rand -hex 32
CORE_API_KEY=change-me
# The first admin. Read once, on the first boot with personal logins, when there are no users yet; after that people
# are managed in the app (Team) and this password is not read again. npm run user -- reset <name> if locked out.
DASHBOARD_USER=ayush
DASHBOARD_PASSWORD=change-me
# Public base URL of the core (for links in n8n and dashboards)
CORE_PUBLIC_URL=http://localhost:8080

# ---- AI provider: gemini | anthropic | mock ----
# gemini: Google AI Studio key (aistudio.google.com > Get API key). Free tier: Google may use the content to improve its products.
GEMINI_API_KEY=
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
# Leave empty for the provider default (gemini: gemini-3.5-flash / gemini-3.5-flash-lite)
AI_MODEL=
AI_MODEL_CHEAP=
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.2
AI_MAX_RETRIES=3
# Research cache: do not re-run an agent on identical input within this many hours
AI_CACHE_TTL_HOURS=720

# ---- Saleshandy: real | mock ----
# mock answers every Saleshandy call from fake fixtures; real needs SALESHANDY_API_KEY as well.
SALESHANDY_MODE=mock
# Saleshandy API key, read only by server code. Never commit, log or paste it anywhere.
SALESHANDY_API_KEY=
# The API host only; paths add /api/open-api/v1 or /v1 themselves.
SALESHANDY_BASE_URL=https://open-api.saleshandy.com
# Secret the webhook sender must present; empty turns the webhook receiver off. Generate with: openssl rand -hex 32
SALESHANDY_WEBHOOK_SECRET=
# Outside production, writes are refused unless every affected email is at one of these domains (comma separated).
SALESHANDY_TEST_ALLOWLIST=
# Outside production, writes are refused unless they touch only this sequence id (the "ops portal test" sequence).
SALESHANDY_TEST_SEQUENCE_ID=
# Most credits the app may spend per calendar month on enrichment, lead finding and verification; empty or 0 means none.
SALESHANDY_MONTHLY_CREDIT_CAP=
# Shows the Saleshandy screens and runs the sync (reads only). true to turn on.
SALESHANDY_INTEGRATION_ENABLED=
# Master switch for every write to Saleshandy. true to turn on; the class flags below must also be on.
SALESHANDY_WRITES_ENABLED=
# Low risk writes: notes, custom fields, tags, task status, prospect field edits.
SALESHANDY_WRITES_LOW=
# Medium risk writes: sequence membership, outcomes, Do Not Contact, blacklist, pausing, creating tasks.
SALESHANDY_WRITES_MEDIUM=
# High risk writes: sending or replying, resuming or creating sequences, removing from Do Not Contact, deletes.
SALESHANDY_WRITES_HIGH=
# Credit-spending calls: enrichment, lead finding, email verification.
SALESHANDY_WRITES_SPEND=

# ---- n8n ----
N8N_HOST=n8n.awtmforge.com
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=change-me-openssl-rand-hex-32
N8N_BASIC_AUTH_USER=ayush
N8N_BASIC_AUTH_PASSWORD=change-me
GENERIC_TIMEZONE=Asia/Kolkata

# ---- Production only (docker compose --profile prod) ----
OPS_HOST=ops.awtmforge.com
ACME_EMAIL=hello@awtmforge.com

# ---- Backups ----
BACKUP_RETENTION_DAYS=14

# ---- Prospect discovery: mock | serper | google_cse (legacy, closed to new customers) ; Apify adapter planned ----
DISCOVERY_SOURCE=mock
# Serper.dev key (2,500 free queries, no card): serper.dev > API key
SERPER_API_KEY=
# Google Programmable Search: create an engine set to "search the entire web" at programmablesearchengine.google.com, key from Google Cloud console
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
DISCOVERY_MAX_PAGES=3
DISCOVERY_DAILY_QUOTA=100

# Signs the ops app session cookie (sign-in). openssl rand -hex 32
SESSION_SECRET=change-me

# ---- Hosting ----
# The core's own timer for sync, daily metrics and weekly analysis. Keep on where n8n is not running (Hostinger Cloud).
SCHEDULER=on
# Connections to Postgres. Chat long-polls do not hold one while they wait, so 5 is plenty for the team.
DB_POOL_MAX=5
