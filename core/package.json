{
  "name": "awtm-outbound-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node dist/server.js",
    "migrate": "node src/migrate.ts",
    "seed": "node src/seed.ts",
    "user": "node src/user-cli.ts",
    "demo": "node src/demo.ts",
    "gen-n8n": "node src/gen-n8n.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 'test/**/*.test.ts'",
    "build": "npm --prefix web ci --include=dev && npm --prefix web run build && tsc -p tsconfig.build.json",
    "dev": "node src/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  }
}
